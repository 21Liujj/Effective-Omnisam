\label{tab:end_to_end}
\small
\begin{tabular}{lcccc}
\toprule
\textbf{阶段与方法} & \textbf{时间/步(s)} & \textbf{时间变化} & \textbf{mIoU(\%)} & \textbf{精度变化} \
\midrule
